@font-face {
  font-family: "Press Start 2P";
  src: url("data:font/woff2;charset=utf-8;base64,") format("woff2");
  font-weight: 400;
  font-style: normal;
}

.phone {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #f3ecdd;
  color: #1a1714;
}

.phone::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .35;
  background-image: radial-gradient(circle at 2rpx 2rpx, rgba(26,23,20,.12) 2rpx, transparent 0);
  background-size: 44rpx 44rpx;
  pointer-events: none;
}

.screens {
  position: relative;
  z-index: 1;
  height: 100%;
  min-height: 0;
}

.screen {
  position: absolute;
  inset: 0;
  padding: var(--page-top, 28rpx) 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  overflow: hidden;
  max-width: 100vw;
}

.active {
  animation: pop .26s ease;
}

@keyframes pop {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.mono {
  font-family: "Press Start 2P", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0;
}

button {
  min-width: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
  text-align: inherit;
}

button::after {
  border: 0;
}

button.soundGate,
button.back,
button.chip,
button.btn,
button.mode,
button.micBig,
button.switchBtn,
button.skipSmash,
button.ctrlSide,
button.navMini,
button.composerMic,
button.choiceNextBtn,
button.intentBtn,
button.detailClose {
  min-width: 0;
  margin-left: 0;
  margin-right: 0;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  min-height: 54rpx;
  padding-right: var(--menu-avoid, 96px);
  box-sizing: border-box;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 8rpx 16rpx 6rpx;
  border: 4rpx solid #1a1714;
  border-radius: 14rpx;
  background: #fffdf6;
  box-shadow: 6rpx 6rpx 0 #1a1714;
  font-size: 18rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.badge.red { background: #ff5a4d; color: #fff; }
.badge.purple { background: #6c5ce7; color: #fff; }
.badge.yellow { background: #f6c518; color: #1a1714; }

.dots {
  font-size: 18rpx;
  opacity: .6;
  font-weight: 800;
}

.back {
  width: auto;
  min-width: 0;
  max-width: 190rpx;
  min-height: 48rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #1a1714;
}

.lead {
  display: block;
  font-weight: 950;
  line-height: 1.08;
}

.welcomeLead {
  margin-top: 4rpx;
  font-size: 56rpx;
}

.configLead,
.modeLead {
  font-size: 44rpx;
}

.gameLead {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 18rpx 4rpx 4rpx;
  text-align: left;
  font-size: 52rpx;
  line-height: 1.05;
  min-width: 0;
  max-width: 100%;
}

.gameLead text + text {
  min-width: 0;
  padding-left: 20rpx;
  border-left: 4rpx solid rgba(26, 23, 20, .22);
  color: #736b5d;
  font-size: 29rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub {
  display: block;
  font-size: 26rpx;
  font-weight: 750;
  color: #6b6253;
  line-height: 1.5;
}

.heroSub {
  display: flex;
  flex-direction: column;
}

.titleMark {
  display: block;
  font-size: 40rpx;
  color: #d24b32;
  font-weight: 900;
}

.card {
  background: #fffdf6;
  border: 6rpx solid #1a1714;
  border-radius: 32rpx;
  box-shadow: 10rpx 10rpx 0 #1a1714;
  padding: 24rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 20rpx;
  border: 4rpx solid #1a1714;
  border-radius: 20rpx;
  background: #fffdf6;
  color: #1a1714;
  box-shadow: 4rpx 4rpx 0 #1a1714;
  font-size: 24rpx;
  font-weight: 850;
  white-space: nowrap;
  box-sizing: border-box;
}

.chip.on {
  background: #1a1714;
  color: #f3ecdd;
}

.chipwrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.btn {
  flex: none;
  width: 100%;
  min-width: 0;
  min-height: 92rpx;
  border: 6rpx solid #1a1714;
  border-radius: 26rpx;
  background: #1a1714;
  color: #f3ecdd;
  box-shadow: 6rpx 6rpx 0 #1a1714;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 950;
  box-sizing: border-box;
}

button.btn {
  width: 100%;
  max-width: 100%;
}

.btn.red { background: #ff5a4d; color: #fff; }
.btn.alt { background: #f6c518; color: #1a1714; }
.btn.ghost { background: #fffdf6; color: #1a1714; }
.btn.huge { min-height: 106rpx; font-size: 32rpx; border-radius: 30rpx; }

.soundGate {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  display: none;
  width: 224rpx;
  min-width: 0;
  border: 6rpx solid #1a1714;
  border-radius: 999rpx;
  background: #f6c518;
  color: #1a1714;
  box-shadow: 6rpx 6rpx 0 #1a1714;
  padding: 16rpx 26rpx;
  font-size: 24rpx;
  font-weight: 950;
  transition: opacity .18s ease, transform .18s ease, background .18s ease;
}

button.soundGate {
  width: 224rpx;
}

button.back {
  margin-left: auto;
  margin-right: 0;
}

.soundGate.loading { background: #fffdf6; }
.soundGate.ready {
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -16rpx);
}

/* HOME */
.homeScreen {
  padding: calc(var(--page-top, 28rpx) + 8rpx) 40rpx calc(34rpx + env(safe-area-inset-bottom));
  justify-content: flex-start;
  gap: 18rpx;
  background: #f8ecd6;
  overflow: hidden;
}

.homeScreen::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 4rpx 4rpx, rgba(26, 23, 20, .14) 4rpx, transparent 0),
    radial-gradient(circle at 3rpx 3rpx, rgba(255, 90, 77, .16) 3rpx, transparent 0);
  background-position: 0 0, 38rpx 76rpx;
  background-size: 96rpx 96rpx, 116rpx 116rpx;
  pointer-events: none;
}

.homeTop,
.homeHeroCopy,
.homePills,
.homeMachineWrap,
.homeResultCards,
.homeStartBtn,
.homeFooter {
  position: relative;
  z-index: 1;
}

.homeTop {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.homeModePill,
.homeCoinPill,
.homeMore {
  min-height: 58rpx;
  border: 7rpx solid #1a1714;
  border-radius: 999rpx;
  background: #fffdf6;
  box-shadow: 8rpx 8rpx 0 rgba(26, 23, 20, .9);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1714;
  font-weight: 950;
}

.homeModePill {
  flex: 1 1 auto;
  max-width: 330rpx;
  gap: 12rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  white-space: nowrap;
}

.homeStatusDot {
  flex: none;
  width: 24rpx;
  height: 24rpx;
  border: 6rpx solid #1a1714;
  border-radius: 999rpx;
  background: #34db87;
  box-sizing: border-box;
}

.homeTopControls {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.homeCoinPill {
  width: 130rpx;
  gap: 14rpx;
  font-size: 26rpx;
}

.homeCoin {
  width: 30rpx;
  height: 30rpx;
  border: 6rpx solid #1a1714;
  border-radius: 999rpx;
  background: #c9c5b8;
  box-shadow: inset 0 0 0 7rpx #eee9dc;
}

.homeMore {
  width: 70rpx;
  min-height: 70rpx;
  font-size: 38rpx;
  line-height: 1;
  background: #1a1714;
  color: #fffdf6;
  box-shadow: none;
}

.homeHeroCopy {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 10rpx;
}

.homeEnglish {
  display: block;
  color: #d24b32;
  font-size: 51rpx;
  line-height: 1;
  text-shadow: 8rpx 8rpx 0 rgba(26, 23, 20, .18);
}

.homeTitle {
  display: block;
  color: #1a1714;
  font-size: 64rpx;
  font-weight: 950;
  line-height: 1.08;
}

.homeDesc {
  display: block;
  max-width: 640rpx;
  margin-top: 8rpx;
  color: #3b3329;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.45;
}

.homeRed {
  color: #d24b32;
  font-weight: 950;
}

.homePills {
  flex: none;
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.homePills text {
  flex: 1 1 0;
  min-width: 0;
  height: 54rpx;
  border: 6rpx solid #1a1714;
  border-radius: 999rpx;
  background: #fffdf6;
  box-shadow: 5rpx 6rpx 0 rgba(26, 23, 20, .84);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1714;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1;
  box-sizing: border-box;
}

.homeMachineWrap {
  flex: 1 1 auto;
  min-height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 2rpx -18rpx 0;
}

.homeMachine {
  position: relative;
  z-index: 3;
  width: 470rpx;
  height: 375rpx;
  margin-top: 52rpx;
  border: 8rpx solid #1a1714;
  border-radius: 54rpx 54rpx 34rpx 34rpx;
  background: #171512;
  box-shadow: 0 16rpx 0 #1a1714, -38rpx 30rpx 0 rgba(255, 90, 77, .15);
  box-sizing: border-box;
}

.homeMachine::before,
.homeMachine::after {
  content: "";
  position: absolute;
  top: 56rpx;
  width: 70rpx;
  height: 190rpx;
  background: #27241f;
}

.homeMachine::before {
  left: -28rpx;
  border-radius: 44rpx 0 0 28rpx;
}

.homeMachine::after {
  right: -28rpx;
  border-radius: 0 44rpx 28rpx 0;
}

.homeMachineLabel {
  position: absolute;
  z-index: 5;
  left: 50%;
  top: -72rpx;
  width: 330rpx;
  height: 92rpx;
  transform: translateX(-50%);
  border: 8rpx solid #1a1714;
  border-radius: 28rpx;
  background: #ff5a4d;
  box-shadow: 8rpx 8rpx 0 rgba(26, 23, 20, .92);
  color: #fffdf6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 950;
  text-shadow: 5rpx 5rpx 0 #1a1714;
  box-sizing: border-box;
}

.homeMachineScreen {
  position: absolute;
  z-index: 4;
  left: 50rpx;
  right: 50rpx;
  top: 108rpx;
  min-height: 126rpx;
  border: 8rpx solid #2f3d40;
  border-radius: 28rpx;
  background: #112424;
  box-shadow: inset 0 0 0 6rpx rgba(54, 245, 255, .12), 0 0 24rpx rgba(54, 245, 255, .2);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  padding: 0 34rpx;
  box-sizing: border-box;
}

.homeMachineScreen text:first-child {
  color: #fffdf6;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.homeMachineScreen text:last-child {
  color: #48f3ff;
  font-size: 21rpx;
  font-weight: 950;
  line-height: 1.15;
}

.homeMachineControls {
  position: absolute;
  left: 76rpx;
  right: 62rpx;
  bottom: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.homeSlot {
  width: 145rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #fff1c9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.homeSlot::before {
  content: "";
  width: 88rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #1a1714;
}

.homeLever {
  display: flex;
  align-items: center;
}

.homeLever text:first-child {
  width: 95rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #ffd443;
}

.homeLever text:last-child {
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  border: 8rpx solid #1a1714;
  border-radius: 999rpx;
  background: #ff5a4d;
  box-sizing: border-box;
}

.homeFloatingCard {
  position: absolute;
  z-index: 2;
  width: 150rpx;
  height: 190rpx;
  border: 8rpx solid #1a1714;
  border-radius: 28rpx;
  background: #fffdf6;
  box-shadow: 10rpx 12rpx 0 rgba(26, 23, 20, .88);
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
  color: #1a1714;
  font-size: 24rpx;
  font-weight: 950;
}

.homeFloatingCard image {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #1a1714;
  border-radius: 22rpx;
}

.homeDistance {
  color: #786f61;
  font-size: 19rpx;
}

.cardLeft {
  left: 12rpx;
  bottom: 38rpx;
  transform: rotate(-12deg);
}

.cardRightTop {
  right: 24rpx;
  top: 42rpx;
  transform: rotate(10deg);
}

.cardRightBottom {
  right: 0;
  bottom: 42rpx;
  transform: rotate(13deg);
}

.homeResultCards {
  flex: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.homeMiniCard {
  min-width: 0;
  min-height: 205rpx;
  border: 7rpx solid #1a1714;
  border-radius: 30rpx;
  background: rgba(255, 253, 246, .94);
  box-shadow: 8rpx 10rpx 0 rgba(26, 23, 20, .88);
  padding: 16rpx 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.homeMiniHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.homeMiniNo {
  flex: none;
  min-width: 60rpx;
  height: 35rpx;
  border: 5rpx solid #1a1714;
  border-radius: 999rpx;
  background: #ff5a4d;
  color: #fffdf6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17rpx;
  box-sizing: border-box;
}

.homeMiniHeader image {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border: 5rpx solid #1a1714;
  border-radius: 18rpx;
}

.homeMiniName {
  display: block;
  color: #1a1714;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.12;
}

.homeMiniMeta {
  display: block;
  color: #796f61;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.homeMiniTag {
  align-self: flex-start;
  margin-top: auto;
  min-height: 34rpx;
  padding: 0 14rpx;
  border: 5rpx solid #1a1714;
  border-radius: 999rpx;
  background: #ffd443;
  color: #1a1714;
  display: flex;
  align-items: center;
  font-size: 19rpx;
  font-weight: 950;
  line-height: 1;
  box-sizing: border-box;
}

.homeStartBtn {
  flex: none;
  min-height: 112rpx;
  border: 8rpx solid #1a1714;
  border-radius: 36rpx;
  background: #ff5a4d;
  box-shadow: 0 12rpx 0 #1a1714;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #fffdf6;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.05;
  text-shadow: 5rpx 5rpx 0 #1a1714;
  box-sizing: border-box;
}

.homeStartLight {
  flex: none;
  width: 116rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: #48f3ff;
}

.homeStartCoin {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  margin-left: -42rpx;
  border: 8rpx solid #1a1714;
  border-radius: 999rpx;
  background: #c9c5b8;
  box-shadow: inset 0 0 0 12rpx #eee9dc;
  box-sizing: border-box;
}

.homeFooter {
  flex: none;
  display: block;
  color: #766d60;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.field {
  min-height: 78rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 4rpx solid #1a1714;
  border-radius: 20rpx;
  background: #f3ecdd;
  color: #1a1714;
  font-size: 28rpx;
  font-weight: 750;
}

/* GAME */
.gameScreen {
  overflow-y: auto;
  overflow-x: hidden;
}

.gameHero {
  flex: none;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 2rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.voiceBox {
  flex: none;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  box-sizing: border-box;
  overflow: hidden;
}

@keyframes pulse {
  50% { opacity: .55; }
}

.locationStatus {
  flex: none;
  min-height: 68rpx;
  max-height: 96rpx;
  padding: 14rpx 20rpx;
  border: 3rpx solid rgba(40, 199, 111, .34);
  border-radius: 26rpx;
  background: #eaf8f0;
  box-shadow: none;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #1d7448;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  box-sizing: border-box;
  overflow: hidden;
}

.locationStatus::before {
  content: "📍";
  flex: none;
  font-size: 30rpx;
  line-height: 1;
}

.locationStatus.gps {
  background: #eaf8f0;
  color: #1d7448;
  border-color: rgba(40, 199, 111, .34);
}

.locationStatus.loading {
  background: #fff3c8;
  color: #5c4b09;
  border-color: rgba(246, 197, 24, .5);
}

.locationStatus.error {
  background: #fffdf6;
  color: #6b6253;
  border-color: rgba(26, 23, 20, .24);
}

.locationStatus.city {
  background: #eaf8f0;
  color: #1d7448;
}

.locationInner {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.locationMain {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.locationMeta {
  display: block;
  max-width: 100%;
  color: rgba(29, 116, 72, .82);
  font-size: 20rpx;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.intentPrompt {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  padding: 0 4rpx;
  color: #6f675a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.28;
}

.intentPromptTitle {
  flex: none;
  padding: 7rpx 18rpx;
  border: 3rpx solid rgba(26, 23, 20, .28);
  border-radius: 999rpx;
  background: #fffdf6;
  color: #1a1714;
}

.intentPromptCopy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.choiceComposer {
  flex: none;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  padding: 14rpx;
  border: 6rpx solid #1a1714;
  border-radius: 44rpx;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 10rpx 0 rgba(26, 23, 20, .72);
  box-sizing: border-box;
  overflow: hidden;
}

.bigInput,
.composerInput {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  height: 184rpx;
  min-height: 184rpx;
  padding: 24rpx;
  border: 4rpx solid #f6c518;
  border-radius: 32rpx;
  background: #fffdf6;
  color: #1a1714;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.42;
  box-sizing: border-box;
}

.composerMic {
  flex: 0 0 108rpx;
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  min-height: 184rpx;
  padding: 0;
  border: 4rpx solid rgba(26, 23, 20, .7);
  border-radius: 32rpx;
  background: #f3ecdd;
  color: #1a1714;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 950;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.composerMic.rec {
  background: #ff5a4d;
  color: #fff;
  border-color: #1a1714;
  box-shadow: inset 0 0 0 6rpx rgba(255,255,255,.16), 0 0 0 4rpx rgba(255, 90, 77, .25);
  animation: micActive .9s ease-in-out infinite;
}

.composerMic.rec .micGlyph {
  animation: micHop .7s ease-in-out infinite;
}

.micRipple {
  position: absolute;
  inset: 8rpx;
  pointer-events: none;
  z-index: 0;
}

.micRipple text {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid rgba(255, 255, 255, .76);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
  animation: micRipple 1.25s ease-out infinite;
}

.micRipple text:last-child {
  animation-delay: .46s;
}

.composerMic .micGlyph,
.composerMic > text:last-child {
  position: relative;
  z-index: 1;
}

.micGlyph {
  font-size: 48rpx;
  line-height: 1;
}

@keyframes micActive {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3rpx); }
}

@keyframes micHop {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.08); }
}

@keyframes micRipple {
  0% { opacity: .7; transform: translate(-50%, -50%) scale(.7); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(3.4); }
}

