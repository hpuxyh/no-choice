}

.detailQualityGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.detailQualityItem {
  padding: 20rpx;
  border-width: 3rpx;
  border-radius: 26rpx;
}

.detailQualityItem text:first-child {
  font-size: 22rpx;
}

.detailQualityItem text:last-child {
  font-size: 34rpx;
}

.detailRouteRow {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr);
  align-items: start;
  padding: 18rpx;
  border-radius: 26rpx;
}

.detailRouteName {
  flex: none;
  font-size: 25rpx;
}

.detailRouteStat {
  padding: 8rpx 14rpx;
  font-size: 23rpx;
}

.detailPhotoStrip {
  height: 150rpx;
}

.detailPhoto {
  width: 198rpx;
  height: 136rpx;
  border-width: 4rpx;
  border-radius: 24rpx;
}

.detailPhoto text {
  font-size: 19rpx;
}

.detailSectionTitle {
  font-size: 23rpx;
}

.detailGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15rpx;
}

.detailItem {
  width: auto;
  flex: none;
  padding: 20rpx;
  border-width: 3rpx;
  border-radius: 26rpx;
}

.detailItem.wide {
  grid-column: 1 / -1;
  width: auto;
}

.detailItem text:first-child {
  font-size: 22rpx;
}

.detailItem text:last-child {
  font-size: 27rpx;
}

.detailActions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 4rpx -24rpx 0;
  padding: 22rpx 24rpx 26rpx;
}

.detailActions .btn {
  min-height: 94rpx;
  border-radius: 30rpx;
  font-size: 29rpx;
}

@media (max-height: 760px) {
  .deckScreen {
    gap: 12rpx;
    padding-left: 34rpx;
    padding-right: 34rpx;
  }
  .roundSlogan {
    padding: 16rpx 22rpx;
    font-size: 28rpx;
  }
  .deckControls {
    height: 132rpx;
    gap: 0;
    padding: 0 4rpx;
  }
  button.ctrlSide,
  .ctrlSide {
    width: 160rpx !important;
    min-width: 160rpx !important;
    max-width: 160rpx !important;
    height: 90rpx;
    min-height: 90rpx;
  }
  .poiDetailHero {
    min-height: 360rpx;
  }
}

/* Visual cleanup: keep WeChat chrome, card carousel, and detail modal from colliding. */
.deckScreen {
