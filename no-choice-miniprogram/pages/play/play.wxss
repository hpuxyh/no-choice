  max-width: 100%;
  overflow: visible;
}

.deck {
  position: absolute;
  left: 50%;
  top: 10rpx;
  transform: translateX(-50%);
  width: 100%;
  max-width: 560rpx;
  height: calc(100% - 20rpx);
  perspective: 1000rpx;
}

.gcard {
  position: absolute;
  inset: 0;
  border: 0;
  border-radius: 36rpx;
  background: #fffdf6;
  box-shadow: 8rpx 10rpx 0 rgba(26,23,20,.72), -2rpx 2rpx 0 rgba(26,23,20,.18), inset 0 0 0 4rpx rgba(26,23,20,.12), 0 28rpx 60rpx rgba(26,23,20,.16);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  will-change: transform;
}

.backCard {
  background: #fffdf6;
}

.layer1 { transform: translateY(18rpx) scale(.96) rotate(2.5deg); z-index: 4; }
.layer2 { transform: translateY(36rpx) scale(.92) rotate(-2.5deg); z-index: 3; }

.faceCard {
  z-index: 10;
  animation: flipReveal .52s cubic-bezier(.3,.7,.4,1);
  transform-origin: center;
}

@keyframes flipReveal {
  0% { transform: rotateY(-88deg) scale(.9); }
  55% { transform: rotateY(10deg) scale(1.03); }
  100% { transform: rotateY(0) scale(1); }
}

.faceCard.flyR {
  transition: transform .4s cubic-bezier(.3,.8,.4,1), opacity .4s;
  transform: translate(780rpx, -80rpx) rotate(20deg) !important;
  opacity: 0;
}

.faceCard.flyL {
  transition: transform .4s cubic-bezier(.3,.8,.4,1), opacity .4s;
  transform: translate(-780rpx, -80rpx) rotate(-20deg) !important;
  opacity: 0;
}

