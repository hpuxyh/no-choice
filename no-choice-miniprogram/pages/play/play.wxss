  border-radius: 14rpx;
  box-shadow: 6rpx 6rpx 0 #1a1714;
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.deckScreen .back {
  justify-self: end;
  max-width: 118rpx;
  padding-top: 0;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
