@media (max-height: 760px) {
  .screen { gap: 14rpx; padding-top: var(--page-top, 24rpx); padding-left: 24rpx; padding-right: 24rpx; padding-bottom: 24rpx; }
  .micBig { min-height: 96rpx; font-size: 25rpx; }
  .voicePrimary { font-size: 30rpx; }
  .gameHero, .voiceBox { gap: 16rpx; }
  .gameLead { padding-top: 8rpx; font-size: 46rpx; }
  .gameLead text + text { font-size: 25rpx; }
  .choiceComposer { gap: 12rpx; padding: 12rpx; }
  .bigInput,
  .composerInput { height: 166rpx; min-height: 166rpx; font-size: 27rpx; }
  .composerMic { flex-basis: 96rpx; width: 96rpx; min-width: 96rpx; max-width: 96rpx; min-height: 166rpx; font-size: 22rpx; }
  .locationStatus { min-height: 68rpx; max-height: 90rpx; font-size: 24rpx; }
  .quickTags, .preferenceSliders { padding: 14rpx; gap: 10rpx; }
  .quickTagRow .chip { font-size: 23rpx; min-height: 54rpx; }
  .choiceNextBtn { width: 100%; min-height: 82rpx; font-size: 28rpx; }
  .deckControls {
    height: 132rpx;
    gap: 0;
  }
  button.ctrlSide,
  .ctrlSide {
    width: 120rpx !important;
    min-width: 120rpx !important;
    max-width: 120rpx !important;
    height: 86rpx;
    min-height: 86rpx;
    margin-bottom: 22rpx;
  }
  .screen-deck .toast { top: calc(var(--page-top, 24rpx) + 148rpx); }
}

