  line-height: 1.2;
}
button.categoryBtn::after { border: none; }
.categoryBtn.coffee { background: #6f4e37; }
.categoryBtn.milktea { background: #d98a5b; }
.categoryBtn.food { background: #ff7a3d; }
.categoryBtn.is-press { transform: translateY(6rpx); box-shadow: 0 4rpx 0 rgba(26, 23, 20, .68); }
.categoryIcon { font-size: 44rpx; flex: 0 0 auto; }
.categoryTextCol { display: flex; flex-direction: column; align-items: center; min-width: 0; }
.categoryName { font-size: 30rpx; font-weight: 950; }
.categoryDesc { font-size: 20rpx; font-weight: 600; opacity: .9; margin-top: 4rpx; }

/* —— 卡面「最近上新」标注 —— */
.newDropTag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  align-self: flex-start;
  margin: 8rpx 0 4rpx;
  padding: 6rpx 16rpx 6rpx 8rpx;
  border-radius: 999rpx;
  background: #ffe9d6;
  color: #b3491f;
  font-size: 22rpx;
  font-weight: 800;
}
.newDropDot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ff5a4d;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
}

/* —— 卡面「你常点」标注(来自零上传行为养成画像) —— */
.preferredTag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin: 8rpx 0 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3c4;
  color: #8a5a00;
  font-size: 22rpx;
  font-weight: 800;
}
