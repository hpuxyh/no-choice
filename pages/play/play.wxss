@font-face {
  font-family: "Press Start 2P";
  src: url("data:font/woff2;charset=utf-8;base64,") format("woff2");
  font-weight: 400;
  font-style: normal;
}

.phone {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #f3ecdd;
  color: #1a1714;
}

.phone::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .35;
  background-image: radial-gradient(circle at 2rpx 2rpx, rgba(26,23,20,.12) 2rpx, transparent 0);
  background-size: 44rpx 44rpx;
  pointer-events: none;
}

.screens {
  position: relative;
  z-index: 1;
  height: 100%;
  min-height: 0;
}

.screen {
  position: absolute;
  inset: 0;
  padding: var(--page-top, 28rpx) 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  overflow: hidden;
  max-width: 100vw;
}

.active {
  animation: pop .26s ease;
}

@keyframes pop {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.mono {
  font-family: "Press Start 2P", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0;
}

button {
  min-width: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
  text-align: inherit;
}

button::after {
  border: 0;
}

button.soundGate,
button.back,
button.chip,
button.btn,
button.mode,
button.ctrlSide,
button.composerMic,
button.choiceNextBtn,
button.intentBtn,
button.detailClose {
  min-width: 0;
  margin-left: 0;
  margin-right: 0;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  min-height: 54rpx;
  padding-right: var(--menu-avoid, 96px);
  box-sizing: border-box;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 8rpx 16rpx 6rpx;
  border: 4rpx solid #1a1714;
  border-radius: 14rpx;
  background: #fffdf6;
  box-shadow: 6rpx 6rpx 0 #1a1714;
  font-size: 18rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.badge.red { background: #ff5a4d; color: #fff; }
.badge.purple { background: #6c5ce7; color: #fff; }
.badge.yellow { background: #f6c518; color: #1a1714; }

.dots {
  font-size: 18rpx;
  opacity: .6;
  font-weight: 800;
}

.back {
  width: auto;
  min-width: 0;
  max-width: 190rpx;
  min-height: 48rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #1a1714;
}

.lead {
  display: block;
  font-weight: 950;
  line-height: 1.08;
}

.gameLead {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 18rpx 4rpx 4rpx;
  text-align: left;
  font-size: 52rpx;
  line-height: 1.05;
  min-width: 0;
  max-width: 100%;
}

.gameLead text + text {
  min-width: 0;
  padding-left: 20rpx;
  border-left: 4rpx solid rgba(26, 23, 20, .22);
  color: #736b5d;
  font-size: 29rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card {
  background: #fffdf6;
  border: 6rpx solid #1a1714;
  border-radius: 32rpx;
  box-shadow: 10rpx 10rpx 0 #1a1714;
  padding: 24rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 20rpx;
  border: 4rpx solid #1a1714;
  border-radius: 20rpx;
  background: #fffdf6;
  color: #1a1714;
  box-shadow: 4rpx 4rpx 0 #1a1714;
  font-size: 24rpx;
  font-weight: 850;
  white-space: nowrap;
  box-sizing: border-box;
}

.chip.on {
  background: #1a1714;
  color: #f3ecdd;
}

.btn {
  flex: none;
  width: 100%;
  min-width: 0;
  min-height: 92rpx;
  border: 6rpx solid #1a1714;
  border-radius: 26rpx;
  background: #1a1714;
  color: #f3ecdd;
  box-shadow: 6rpx 6rpx 0 #1a1714;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 950;
  box-sizing: border-box;
}

button.btn {
  width: 100%;
  max-width: 100%;
}

.btn.red { background: #ff5a4d; color: #fff; }
.btn.alt { background: #f6c518; color: #1a1714; }
.btn.ghost { background: #fffdf6; color: #1a1714; }

.soundGate {
  position: fixed;
  right: 176rpx;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  min-width: 74rpx;
  min-height: 62rpx;
  border: 5rpx solid #1a1714;
  border-radius: 999rpx;
  background: #f6c518;
  color: #1a1714;
  box-shadow: 5rpx 5rpx 0 #1a1714;
  padding: 0;
  font-size: 30rpx;
  font-weight: 950;
  transition: opacity .18s ease, transform .18s ease, background .18s ease;
}

button.soundGate {
  width: 74rpx;
}

button.back {
  margin-left: auto;
  margin-right: 0;
}

.soundGate.loading { background: #fffdf6; }
.soundGate.ready {
  opacity: 1;
  pointer-events: auto;
}

.soundGate.muted {
  background: #ff5a4d;
  color: #fffaf2;
}

.field {
  min-height: 78rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 4rpx solid #1a1714;
  border-radius: 20rpx;
  background: #f3ecdd;
  color: #1a1714;
  font-size: 28rpx;
  font-weight: 750;
}

/* GAME */
.gameScreen {
  overflow-y: auto;
  overflow-x: hidden;
}

.gameHero {
  flex: none;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 2rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.voiceBox {
  flex: none;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

@keyframes pulse {
  50% { opacity: .55; }
}

.locationStatus {
  flex: none;
  min-height: 68rpx;
  max-height: 96rpx;
  padding: 14rpx 20rpx;
  border: 3rpx solid rgba(40, 199, 111, .34);
  border-radius: 26rpx;
  background: #eaf8f0;
  box-shadow: none;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #1d7448;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  box-sizing: border-box;
  overflow: hidden;
}

.locationStatus::before {
  content: "📍";
  flex: none;
  font-size: 30rpx;
  line-height: 1;
}

.locationStatus.gps {
  background: #eaf8f0;
  color: #1d7448;
  border-color: rgba(40, 199, 111, .34);
}

.locationStatus.loading {
  background: #fff3c8;
  color: #5c4b09;
  border-color: rgba(246, 197, 24, .5);
}

.locationStatus.error {
  background: #fffdf6;
  color: #6b6253;
  border-color: rgba(26, 23, 20, .24);
}

.locationStatus.city {
  background: #eaf8f0;
  color: #1d7448;
}

.locationInner {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.locationMain {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.locationMeta {
  display: block;
  max-width: 100%;
  color: rgba(29, 116, 72, .82);
  font-size: 20rpx;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.intentPrompt {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  padding: 0 4rpx 0 2rpx;
  color: #6f675a;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.28;
}

.intentPromptTitle {
  flex: none;
  padding: 7rpx 18rpx 6rpx;
  border: 3rpx solid rgba(26, 23, 20, .28);
  border-radius: 999rpx;
  background: #fffdf6;
  color: #1a1714;
  box-shadow: 0 3rpx 0 rgba(26, 23, 20, .22);
}

.intentPromptCopy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meetupRoomPanel {
  flex: none;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 18rpx;
  border: 6rpx solid #1a1714;
  border-radius: 36rpx;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 10rpx 0 rgba(26, 23, 20, .66), inset 0 0 0 2rpx rgba(255, 255, 255, .72);
  box-sizing: border-box;
  overflow: hidden;
}

.meetupRoomPanel {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: rgba(255, 253, 246, .98);
}

.multiAreaRows {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.multiAreaRow {
  padding: 14rpx;
  border: 4rpx solid rgba(26, 23, 20, .14);
  border-radius: 24rpx;
  background: #fffefa;
  box-sizing: border-box;
}

.meetupMapShell {
  position: relative;
  width: 100%;
  height: 330rpx;
  border: 5rpx solid #1a1714;
  border-radius: 28rpx;
  overflow: hidden;
  background: #dfeee6;
  box-shadow: 0 8rpx 0 rgba(26, 23, 20, .36);
  box-sizing: border-box;
}

.meetupRoomMap {
  width: 100%;
  height: 100%;
}

.momentComposerShell {
  flex: none;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 16rpx;
  border: 6rpx solid #1a1714;
  border-radius: 38rpx;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 10rpx 0 rgba(26, 23, 20, .68), inset 0 0 0 2rpx rgba(255, 255, 255, .7);
  box-sizing: border-box;
  overflow: hidden;
}

.momentComposerShell.insightMode {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.choiceComposer {
  flex: none;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
  overflow: hidden;
}

.momentComposerShell.insightMode .choiceComposer {
  padding: 16rpx;
  border: 6rpx solid #1a1714;
  border-radius: 38rpx;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 10rpx 0 rgba(26, 23, 20, .68), inset 0 0 0 2rpx rgba(255, 255, 255, .7);
}

.composerInputPanel {
  flex: 1 1 0;
  min-width: 0;
  height: 198rpx;
  min-height: 198rpx;
  padding: 18rpx 22rpx 16rpx;
  border: 4rpx solid #f6c518;
  border-radius: 28rpx;
  background: #fffefa;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.composerMiniHead {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.composerAiBadge {
  flex: none;
  min-height: 38rpx;
  padding: 0 15rpx;
  border: 4rpx solid #1a1714;
  border-radius: 999rpx;
  background: #e9fff5;
  color: #0b754a;
  display: flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 950;
  line-height: 1;
}

.composerMiniHint {
  min-width: 0;
  color: #8a8378;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bigInput,
.composerInput {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  height: 118rpx;
  min-height: 118rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #1a1714;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.28;
  box-sizing: border-box;
}

.composerMic {
  flex: 0 0 100rpx;
  width: 100rpx;
  min-width: 100rpx;
  max-width: 100rpx;
  min-height: 198rpx;
  padding: 0;
  border: 4rpx solid rgba(26, 23, 20, .7);
  border-radius: 28rpx;
  background: #f3ecdd;
  color: #1a1714;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  font-size: 24rpx;
  font-weight: 950;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.composerMic.rec {
  background: #ff5a4d;
  color: #fff;
  border-color: #1a1714;
  box-shadow: inset 0 0 0 6rpx rgba(255,255,255,.16), 0 0 0 4rpx rgba(255, 90, 77, .25);
  animation: micActive .9s ease-in-out infinite;
}

.composerMic.rec .micGlyph {
  animation: micHop .7s ease-in-out infinite;
}

.micRipple {
  position: absolute;
  inset: 8rpx;
  pointer-events: none;
  z-index: 0;
}

.micRipple text {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid rgba(255, 255, 255, .76);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
  animation: micRipple 1.25s ease-out infinite;
}

.micRipple text:last-child {
  animation-delay: .46s;
}

.composerMic .micGlyph,
.composerMic > text:last-child {
  position: relative;
  z-index: 1;
}

.micGlyph {
  font-size: 38rpx;
  line-height: 1;
}

@keyframes micActive {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3rpx); }
}

@keyframes micHop {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.08); }
}

@keyframes micRipple {
  0% { opacity: .7; transform: translate(-50%, -50%) scale(.7); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(3.4); }
}

.voiceInsight {
  flex: none;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx;
  border: 5rpx solid #1a1714;
  border-radius: 30rpx;
  background: #fffdf6;
  box-shadow: 0 8rpx 0 rgba(26, 23, 20, .68);
  box-sizing: border-box;
  overflow: hidden;
}

.voiceInsightHeader {
  position: relative;
  min-height: 52rpx;
  padding: 15rpx 18rpx 15rpx 72rpx;
  border: 3rpx solid rgba(26, 23, 20, .22);
  border-radius: 24rpx;
  background: #fff7df;
  display: flex;
  align-items: center;
  color: #1a1714;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.28;
}

.voiceInsightHeader::before {
  content: "AI";
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #1a1714;
  border-radius: 12rpx;
  background: #f6c518;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Press Start 2P", ui-monospace, monospace;
  font-size: 13rpx;
  font-weight: 400;
}

.voiceSectionTitle {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #1a1714;
  font-size: 22rpx;
  font-weight: 950;
}

.voiceSectionTitle::after {
  content: "";
  flex: 1;
  height: 3rpx;
  background: rgba(26, 23, 20, .16);
}

.voiceInsightDetails {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.voiceInsightItem {
  flex: 1 1 calc(50% - 10rpx);
  width: calc(50% - 10rpx);
  min-width: 0;
  min-height: 92rpx;
  padding: 13rpx 15rpx;
  border: 3rpx solid rgba(26, 23, 20, .22);
  border-radius: 20rpx;
  background: #fffaf0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.voiceInsightItem.wide {
  flex-basis: 100%;
  width: 100%;
}

.voiceInsightKey {
  color: #736b5d;
  font-size: 19rpx;
  font-weight: 900;
}

.voiceInsightItemTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.voiceInsightEditHint {
  flex: none;
  min-height: 30rpx;
  padding: 0 10rpx;
  border: 2rpx solid rgba(26, 23, 20, .30);
  border-radius: 999rpx;
  background: #fffdf6;
  color: #746b5e;
  display: flex;
  align-items: center;
  font-size: 17rpx;
  font-weight: 950;
  line-height: 1;
}

.voiceInsightVal {
  color: #1a1714;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.22;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.voiceInsightInput {
  width: 100%;
  height: 56rpx;
  min-height: 56rpx;
  padding: 8rpx 10rpx;
  border: 2rpx solid rgba(26, 23, 20, .18);
  border-radius: 12rpx;
  background: #fffefa;
  color: #1a1714;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.2;
  box-sizing: border-box;
}

.voiceInsightInput.multiline {
  height: 84rpx;
  min-height: 84rpx;
  max-height: 84rpx;
}

.voiceInsight.ready .voiceInsightItem {
  background: #fffaf0;
}

.voiceInsightItem.editable {
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .74);
}

.voiceInsightItem.editing {
  border-color: #f6c518;
  background: #fff7df;
  box-shadow: 0 5rpx 0 rgba(26, 23, 20, .18), inset 0 0 0 2rpx rgba(246, 197, 24, .18);
}

.voiceInsightItem.editing .voiceInsightEditHint {
  background: #f6c518;
  border-color: #1a1714;
  color: #1a1714;
}

.voiceInsightSummary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 16rpx;
  border: 5rpx solid #1a1714;
  border-radius: 24rpx;
  background: #101b1b;
  color: #eaffff;
  box-shadow: 0 7rpx 0 rgba(26, 23, 20, .68);
  box-sizing: border-box;
}

.voiceSummaryChip {
  min-width: 0;
  min-height: 68rpx;
  padding: 11rpx 12rpx;
  border: 3rpx solid rgba(138, 255, 255, .28);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .07);
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  box-sizing: border-box;
}

.voiceSummaryChip text:first-child {
  color: rgba(234, 255, 255, .68);
  font-size: 17rpx;
  font-weight: 900;
}

.voiceSummaryChip text:last-child {
  color: #eaffff;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voiceInsightActions {
  display: flex;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
}

.voiceInsightLoading {
  width: 100%;
  min-height: 74rpx;
  padding: 0 22rpx;
  border: 4rpx dashed rgba(26, 23, 20, .34);
  border-radius: 22rpx;
  background: rgba(255, 253, 246, .72);
  color: #6f675a;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 25rpx;
  font-weight: 950;
  box-sizing: border-box;
}

.voiceLoadingDot {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #f6c518;
  box-shadow: 0 0 0 0 rgba(246, 197, 24, .45);
  animation: loadingDotPulse 1s ease-in-out infinite;
}

@keyframes loadingDotPulse {
  0%, 100% {
    transform: scale(.8);
    box-shadow: 0 0 0 0 rgba(246, 197, 24, .45);
  }
  50% {
    transform: scale(1.15);
    box-shadow: 0 0 0 12rpx rgba(246, 197, 24, 0);
  }
}

.intentBtn {
  flex: 1 1 0;
  min-width: 0;
  min-height: 66rpx;
  border: 4rpx solid #1a1714;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 950;
}

