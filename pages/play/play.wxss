/* =========================================================
   UX POLISH LAYER  (2026-06-11)
   surgical refinements on top of the brutalist base
   - tactile press feedback (.is-press)
   - cleaner neutral states (textarea, location pill)
   - clearer disabled state
   - bigger tap targets on chips
   - smoother chip / slider visuals
   ========================================================= */

/* --- 1. Universal tactile press feedback for primary buttons.
   Bound from WXML via hover-class="is-press"; the brutalist
   shadow sits below, so a press shifts the element into its
   shadow and looks/feels like a real keycap. */
.is-press {
  transform: translate(3rpx, 3rpx);
  transition: transform .08s ease-out, box-shadow .08s ease-out;
  filter: brightness(.97);
}

button.choiceNextBtn.is-press,
.choiceNextBtn.is-press {
  transform: translate(4rpx, 4rpx);
  box-shadow: 0 4rpx 0 rgba(26, 23, 20, .68);
}

button.ctrlSide.is-press,
.ctrlSide.is-press {
  transform: translate(3rpx, 3rpx);
  box-shadow: 3rpx 3rpx 0 #1a1714 !important;
}

button.btn.is-press,
.btn.is-press {
  transform: translate(3rpx, 3rpx);
  box-shadow: 3rpx 3rpx 0 #1a1714;
}

button.intentBtn.is-press,
.intentBtn.is-press {
  transform: translate(2rpx, 2rpx);
  box-shadow: 0 2rpx 0 rgba(26, 23, 20, .7);
}

button.is-press::after { border: 0; }

/* --- 2. Composer textarea — drop the permanent yellow border
   (reads as an error/warning state in screenshots). Use a
   neutral border by default; reserve the warm yellow accent
   for the focused state only. */
.composerInputPanel {
  border: 3rpx solid rgba(26, 23, 20, .14);
  background: #fffefa;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .9);
  transition: border-color .18s ease, box-shadow .18s ease;
}

.composerInputPanel.is-focused {
  border-color: #f6c518;
  box-shadow: 0 0 0 4rpx rgba(246, 197, 24, .14), inset 0 0 0 1rpx rgba(255, 255, 255, .9);
}

/* clearer hint colour so AI badge + hint aren't a visual cluster */
.composerAiBadge {
  background: #1a1714;
  color: #f6c518;
  border-color: #1a1714;
}

/* --- 3. Location pill — keep colour-coded states but soften
   the saturation so it doesn't fight the page background. */
.locationStatus {
  border-radius: 22rpx;
  padding: 12rpx 18rpx;
  letter-spacing: 0;
}

.locationStatus.gps,
.locationStatus.city {
  background: rgba(40, 199, 111, .12);
  color: #1d7448;
  border-color: rgba(40, 199, 111, .28);
}

.locationStatus.loading {
  background: rgba(246, 197, 24, .14);
  color: #6f5106;
  border-color: rgba(246, 197, 24, .42);
}

.locationStatus.error {
  background: rgba(255, 90, 77, .08);
  color: #a13b30;
  border-color: rgba(255, 90, 77, .32);
}

.locationStatus::before {
  font-size: 26rpx;
  opacity: .82;
}

/* --- 4. Clearer disabled state. opacity:.72 alone reads as
   "low contrast" rather than "not tappable". Desaturate +
   flatten the shadow so it visibly recedes. */
.choiceNextBtn.disabled {
  background: #efe7d2;
  color: rgba(26, 23, 20, .42);
  box-shadow: 0 4rpx 0 rgba(26, 23, 20, .18);
  opacity: 1;
}

/* --- 5. Inspiration chips — current 50rpx min-height is below
   the 44px (≈88rpx) tap-target guideline. Lift to 60rpx and
   give the selected state a tighter, more confident look. */
.quickTagRow .chip {
  min-height: 60rpx;
  padding: 0 24rpx;
  border-width: 3rpx;
  border-color: rgba(26, 23, 20, .22);
  background: #fffefa;
  box-shadow: 0 3rpx 0 rgba(26, 23, 20, .14);
  transition: transform .14s ease, background .14s ease, border-color .14s ease, color .14s ease, box-shadow .14s ease;
}

.quickTagRow .chip.on {
  background: #1a1714;
  color: #fffdf6;
  border-color: #1a1714;
  box-shadow: 0 3rpx 0 rgba(26, 23, 20, .42);
  transform: translateY(-1rpx);
}

.quickTagRow .chip.is-press {
  transform: translateY(1rpx);
  box-shadow: 0 1rpx 0 rgba(26, 23, 20, .14);
}

/* --- 6. Preference sliders. Lift contrast on the value pill
   and align the layout so the value never gets cut off. */
.preferenceSliderRow {
  padding: 14rpx 18rpx 8rpx;
  border-color: rgba(26, 23, 20, .14);
  background: #fffefa;
  box-shadow: 0 3rpx 0 rgba(26, 23, 20, .08);
}

.preferenceSliderHead {
  margin-bottom: 4rpx;
}

.preferenceValue {
  max-width: 160rpx;
  padding: 4rpx 14rpx 3rpx;
  border-color: rgba(26, 23, 20, .22);
  background: #f6c518;
  color: #1a1714;
  font-size: 21rpx;
  letter-spacing: 0;
}

/* --- 7. Voice-insight detail cards — values were 23rpx vs the
   ambient body of 25-29rpx; bump for readability without
   widening the grid. */
.voiceInsightItem {
  padding: 14rpx 16rpx;
  border-color: rgba(26, 23, 20, .16);
  background: #fffefa;
  box-shadow: 0 2rpx 0 rgba(26, 23, 20, .06);
  transition: border-color .16s ease, background .16s ease, box-shadow .16s ease;
}

.voiceInsightKey {
  font-size: 20rpx;
  letter-spacing: .4rpx;
  text-transform: none;
}

.voiceInsightVal {
  font-size: 26rpx;
  line-height: 1.28;
}

.voiceInsightItem.editable {
  border-style: dashed;
  border-color: rgba(26, 23, 20, .28);
}

.voiceInsightItem.editing {
  border-style: solid;
  border-color: #f6c518;
  background: #fffaea;
  box-shadow: 0 4rpx 0 rgba(246, 197, 24, .35);
}

.voiceInsightHeader {
  background: #1a1714;
  color: #fffdf6;
  border-color: #1a1714;
}

.voiceInsightHeader::before {
  border-color: #fffdf6;
  background: #f6c518;
  color: #1a1714;
}

/* --- 8. Area-mode cards: make the two options feel like a real
   choice — slightly more visual weight, gentler shadows when
   not active{
  transition: transform .14s ease, box-shadow .14s ease, border-color .14s ease;
}

/* --- 9. Deck controls. Add a subtle "ready" pulse on the active
   card so it feels alive, and add a directional hint that the
   pass / pick buttons are siblings to the swipe gesture. */
.faceCard:not(.flyL):not(.flyR) {
  transition: transform .16s ease;
}

.deckControls {
  margin-top: 12rpx;
}

.ctrlSide .big {
  letter-spacing: 1rpx;
}

.ctrlSide .sm {
  opacity: .9;
}

/* --- 10. Win card — gentler entrance + breathable button row.
   The previous drop from -120vh felt cartoonish for the calm
   reveal moment. */
.winCard {
  animation: winDrop .42s cubic-bezier(.2, .9, .35, 1);
}

@keyframes winDrop {
  0% { transform: translateY(-40rpx) scale(.94); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

.winCard .links .btn {
  transition: transform .12s ease, box-shadow .12s ease;
}

.winCard .links .btn.is-press {
  transform: translate(3rpx, 3rpx);
  box-shadow: 3rpx 3rpx 0 #1a1714;
}

/* --- 11. Detail modal close button — current 74rpx circle with
   46rpx ×. Make the glyph optically centred and add a subtle
   hover-feedback. */
button.detailClose,
.detailClose {
  line-height: 64rpx;
}

button.detailClose.is-press,
.detailClose.is-press {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(26, 23, 20, .82);
}

/* --- 12. Moment composer shell — drop the heavy 10rpx bottom
   shadow that competes with the chip strip below it. Subtle
   floating feel is enough. */
.momentComposerShell {
  box-shadow: 0 6rpx 0 rgba(26, 23, 20, .42), inset 0 0 0 2rpx rgba(255, 255, 255, .7);
}

/* --- 13. Voice summary chip rail (dark teal panel) — current
   chips can clip their value; allow two-line wrap on summary. */
.voiceSummaryChip {
  min-height: 76rpx;
}

.voiceSummaryChip text:last-child {
  white-space: normal;
  line-height: 1.2;
}

/* --- 14. Loading state under deck — make the spinner ring use
   the brand red instead of the generic purple. */
.spinner {
  border-top-color: #ff5a4d;
}

/* --- 15. Toast — softer corners, less harsh contrast on the
   warm cream background. */
.toast {
  background: rgba(26, 23, 20, .94);
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: .5rpx;
  backdrop-filter: blur(8rpx);
}

/* --- 16. Quick-tag fade gradient — current right-side fade
   over rgba(255,250,240,.94) doesn't match the actual panel
   bg of rgba(255,250,240,.72). Re-align so the fade blends. */
.quickTagFade {
  background: linear-gradient(90deg, rgba(255, 250, 240, 0), rgba(255, 254, 250, .98));
}

/* --- 17. Small-screen tightening (paired with existing
   max-height:760px rule). The voice insight cards were
   wrapping their two-column grid too tightly on iPhone SE. */
@media (max-height: 760px) {
  .voiceInsightDetails { gap: 10rpx; }
  .voiceInsightItem { min-height: 84rpx; padding: 12rpx 14rpx; }
  .voiceInsightVal { font-size: 24rpx; }
  .quickTagRow .chip { min-height: 56rpx; padding: 0 20rpx; }
  .preferenceSliderRow { padding: 12rpx 14rpx 6rpx; }
}

