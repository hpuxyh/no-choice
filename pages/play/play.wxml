<button class="soundGate mono {{bgmPlaying ? 'ready' : ''}} {{bgmLoading ? 'loading' : ''}} {{bgmMuted ? 'muted' : ''}}" style="top: {{soundTop}}px;" catchtap="toggleBgm">
  {{bgmLabel}}
</button>

<view class="phone screen-{{screen}}" style="--page-top: {{pageTop}}px; --menu-avoid: {{menuRightPad}}px;">
  <view class="screens">

    <view wx:if="{{screen == 'game'}}" class="screen gameScreen active">
      <view class="topbar">
        <text class="badge yellow">不做选择</text>
      </view>

      <view class="gameHero">
        <view class="lead gameLead">
          <text>选择难？</text>
          <text>开一局就有答案</text>
        </view>

        <view wx:if="{{areaMode != 'multi' || (areaStep != 'multi' && areaStep != 'board')}}" class="locationStatus {{locationState}}">
          <view class="locationInner">
            <text class="locationMain">{{locationText}}</text>
            <text wx:if="{{locationMeta}}" class="locationMeta">{{locationMeta}}</text>
          </view>
        </view>

        <view class="voiceBox {{showVoiceInsight ? 'hasInsight' : ''}}">
          <view wx:if="{{!showVoiceInsight && areaStep == 'multi'}}" class="meetupRoomPanel">
            <view class="mrHeader">
              <view class="mrHeaderText">
                <text class="mrTitle">多人组局</text>
                <text class="mrSub">每人填自己的位置和说明，收齐后自动开始</text>
              </view>
              <view class="mrHeaderActions">
                <text class="mrProgressBadge">{{meetupProgressBadgeText}}</text>
                <view class="mrHomeLink" data-mode="single" bindtap="selectAreaMode">
                  <view class="mrHomeIcon"><view class="mrHomeRoof"></view><view class="mrHomeBody"></view></view>
                  <text>回到首页</text>
                </view>
              </view>
            </view>

            <view class="meetupMapShell">
              <map
                class="meetupRoomMap"
                latitude="{{meetupRoomMapLat}}"
                longitude="{{meetupRoomMapLng}}"
                scale="13"
                markers="{{meetupRoomMarkers}}"
                polyline="{{meetupRoomPolylines}}"
                circles="{{meetupRoomCircles}}"
                include-points="{{meetupRoomIncludePoints}}"
                show-location="{{true}}"
              ></map>
            </view>
            <view wx:if="{{!meetupSharedMode}}" class="mrMapStatus">
              <text class="mrMapStatusText">{{meetupRoomStatus}}</text>
              <text class="mrMapStatusBtn" bindtap="refreshMeetupRoomLocation">更新我的位置</text>
            </view>

            <view wx:if="{{!meetupSharedMode}}" class="mrPeopleHead">
              <text class="mrPeopleTitle">{{meetupSharedMode ? '我的出发地' : '成员出发地'}}</text>
              <text class="mrPeopleHint">{{meetupSharedMode ? '只填你自己的这一份' : '把群里大家的位置和口味填进来'}}</text>
            </view>

            <view wx:if="{{!meetupSharedMode}}" class="mrPeopleList">
              <view wx:for="{{multiAreaRows}}" wx:key="id" class="mrPerson {{item.location ? 'joined' : 'pending'}} {{item.isHost ? 'host' : ''}}">
                <view class="mrPersonTop">
                  <text class="mrAvatar">{{item.roleShort}}</text>
                  <view class="mrNameWrap">
                    <text class="mrName">{{item.role}}</text>
                    <text class="mrStatus">{{item.statusText}}</text>
                  </view>
                  <view class="mrStepper">
                    <text class="mrStepBtn" data-index="{{index}}" data-delta="-1" catchtap="adjustMultiAreaPeople">−</text>
                    <text class="mrStepVal">{{item.people}}人</text>
                    <text class="mrStepBtn" data-index="{{index}}" data-delta="1" catchtap="adjustMultiAreaPeople">＋</text>
                  </view>
                  <text wx:if="{{multiAreaRows.length > 2 && !item.isHost}}" class="mrRemove" data-index="{{index}}" catchtap="removeMultiAreaRow">×</text>
                </view>
                <view class="mrLocationRow">
                  <input class="mrLocation" value="{{item.location}}" placeholder="{{item.placeholder}}" data-index="{{index}}" bindinput="onMultiAreaLocationInput" />
                  <button class="mrPickLocation" data-index="{{index}}" hover-class="is-press" hover-stay-time="80" catchtap="chooseMultiAreaLocation">地图选点</button>
                </view>
                <view class="mrPrefsBody">
                  <view class="mrPrefInputRow">
                    <input class="mrPrefInput" value="{{item.pref}}" placeholder="口味/忌口，如：清淡、不吃香菜、不吃辣" data-index="{{index}}" bindinput="onMultiAreaPrefInput" />
                    <view class="mrPrefMic {{recording && voiceTarget == 'pref:' + index ? 'rec' : ''}}" data-index="{{index}}" catchtap="startMultiAreaPrefVoice">
                      <text class="mrPrefMicGlyph">🎙️</text>
                    </view>
                  </view>
                  <view class="mrPrefGroup">
                    <text class="mrPrefLabel">出行</text>
                    <view class="mrChips">
                      <text wx:for="{{travelOptions}}" wx:for-item="opt" wx:for-index="oi" wx:key="key" class="mrChip {{item.travelMap[opt.key] ? 'on' : ''}}" data-index="{{index}}" data-value="{{opt.key}}" catchtap="toggleMultiAreaTravel">{{opt.icon}} {{opt.key}}</text>
                    </view>
                  </view>
                </view>
              </view>

              <button wx:if="{{multiAreaRows.length < 6}}" class="mrAddPerson" hover-class="is-press" hover-stay-time="80" bindtap="addMultiAreaRow">＋ 加一个朋友位</button>
            </view>

            <view wx:if="{{meetupSharedMode}}" class="mrPeopleList mrSharedSelfList">
              <view wx:for="{{meetupSelfRows}}" wx:key="id" class="mrSelfCard {{item.location ? 'joined' : 'pending'}}">
                <view class="mrSelfHead">
                  <text class="mrSelfTitle">我的出发信息</text>
                  <input class="mrNicknameInput" type="nickname" value="{{meetupSelfName}}" placeholder="点一下用微信昵称" bindinput="onMeetupNicknameInput" />
                  <text class="mrSelfSource">{{item.locationSourceText}}</text>
                </view>
                <view class="mrLocationRow">
                  <input class="mrLocation mrLocationUnified" value="{{item.location}}" placeholder="默认当前定位，可输入或点修改" data-index="{{item.index}}" bindinput="onMultiAreaLocationInput" />
                  <button class="mrPickLocation compact" data-index="{{item.index}}" hover-class="is-press" hover-stay-time="80" catchtap="chooseMultiAreaLocation">修改</button>
                </view>
                <view class="mrPrefsBody">
                  <view class="mrPrefInputRow">
                    <input class="mrPrefInput" value="{{item.pref}}" placeholder="口味/说明：清淡、不吃辣，想安静一点" data-index="{{item.index}}" bindinput="onMultiAreaPrefInput" />
                    <view class="mrPrefMic {{recording && voiceTarget == 'pref:' + item.index ? 'rec' : ''}}" data-index="{{item.index}}" catchtap="startMultiAreaPrefVoice">
                      <text class="mrPrefMicGlyph">🎙️</text>
                    </view>
                  </view>
                  <view class="mrPrefGroup">
                    <text class="mrPrefLabel">出行</text>
                    <view class="mrChips">
                      <text wx:for="{{travelOptions}}" wx:for-item="opt" wx:for-index="oi" wx:key="key" class="mrChip {{item.travelMap[opt.key] ? 'on' : ''}}" data-index="{{item.index}}" data-value="{{opt.key}}" catchtap="toggleMultiAreaTravel">{{opt.icon}} {{opt.key}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>

            <view wx:if="{{meetupSharedMode}}" class="mrRoster">
              <button class="mrShareBtn large" open-type="share" hover-class="is-press" hover-stay-time="80">邀请朋友填位置</button>
              <view wx:if="{{meetupMemberStatusRows && meetupMemberStatusRows.length}}" class="mrStatusList">
                <view wx:for="{{meetupMemberStatusRows}}" wx:key="id" class="mrStatusRow {{item.fillDone ? 'done' : 'editing'}}">
                  <view class="mrStatusAvatar">
                    <text>{{item.avatarText}}</text>
                  </view>
                  <view class="mrStatusText">
                    <text class="mrStatusName">{{item.label}}</text>
                    <text class="mrStatusDetail">{{item.fillDetailText}}</text>
                  </view>
                  <text class="mrStatusPill {{item.fillDone ? 'done' : 'editing'}}">{{item.fillStatusText}}</text>
                </view>
              </view>
              <text wx:if="{{meetupRoomSyncText}}" class="mrSyncSub">{{meetupRoomSyncText}}</text>
            </view>

            <view class="mrFoot">
              <button class="mrPrimaryBtn {{multiAreaReady ? '' : 'disabled'}}" hover-class="{{multiAreaReady ? 'is-press' : ''}}" hover-stay-time="100" bindtap="showMeetupRoomBoard">{{meetupBoardLoading ? '正在算中间点…' : meetupProgressButtonText}}</button>
            </view>
          </view>

          <view wx:if="{{!showVoiceInsight && areaStep == 'board'}}" class="meetupBoardPanel">
            <view class="mrHeader">
              <view class="mrHeaderText">
                <text class="mrTitle">今晚去哪家？</text>
                <text class="mrSub">{{meetupBoard.participantCount}} 人局 · {{meetupBoard.headline}}</text>
              </view>
              <view class="mrBackGroup">
                <text class="mrBack" bindtap="backToMeetupCollect">← 改出发地</text>
                <view class="mrHomeLink" data-mode="single" bindtap="selectAreaMode">
                  <view class="mrHomeIcon"><view class="mrHomeRoof"></view><view class="mrHomeBody"></view></view>
                  <text>回到首页</text>
                </view>
              </view>
            </view>

            <view class="meetupMapShell">
              <map
                class="meetupRoomMap"
                latitude="{{meetupBoard.middle.lat}}"
                longitude="{{meetupBoard.middle.lng}}"
                scale="12"
                markers="{{meetupBoard.markers}}"
                polyline="{{meetupBoard.polylines}}"
                circles="{{meetupBoard.circles}}"
                include-points="{{meetupBoard.includePoints}}"
              ></map>
            </view>

            <view class="arrivalBoard mbBoard" wx:if="{{meetupBoard.arrivalBoard}}">
              <view class="arrivalBoardHead">
                <text>谁到中间点要多久</text>
                <text class="arrivalBoardHint">点一行换交通方式</text>
              </view>
              <view wx:for="{{meetupBoard.arrivalBoard.rows}}" wx:key="label" class="arrivalRow {{item.expanded ? 'open' : ''}}" data-index="{{index}}" bindtap="toggleMeetupBoardRow">
                <view class="arrivalRowTop">
                  <text class="arrivalAvatar">{{item.short}}</text>
                  <text class="arrivalPlace">{{item.label}}</text>
                  <text wx:if="{{item.farthest}}" class="arrivalFarTag">最远</text>
                  <text class="arrivalMin {{item.farthest ? 'far' : ''}}">{{item.recommendedText}}</text>
                  <text class="arrivalCaret">{{item.expanded ? '▲' : '▼'}}</text>
                </view>
                <view wx:if="{{item.expanded}}" class="arrivalModes">
                  <view wx:for="{{item.modes}}" wx:for-item="mode" wx:key="key" class="arrivalMode {{mode.on ? 'on' : ''}} {{mode.tooFar ? 'dim' : ''}}">
                    <view class="arrivalModeLine">
                      <text class="arrivalModeName">{{mode.icon}} {{mode.name}} {{mode.minText}}</text>
                      <text wx:if="{{mode.note}}" class="arrivalModeNote">{{mode.note}}</text>
                    </view>
                    <view wx:if="{{mode.key == 'subway' && mode.rideMin}}" class="arrivalSeg">
                      <view class="arrivalSegBar">
                        <view class="segWalk" style="flex: {{mode.walkMin}};"></view>
                        <view class="segRide" style="flex: {{mode.rideMin}};"></view>
                        <view class="segWalk" style="flex: {{mode.walkMin}};"></view>
                      </view>
                      <view class="arrivalSegText">
                        <text>步行 {{mode.walkMin}} 分</text>
                        <text>步行 {{mode.walkMin}} 分</text>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>

            <view wx:if="{{meetupBoard.summary}}" class="mbSummary">{{meetupBoard.summary}}</view>

            <view class="mrFoot">
              <button class="mrPrimaryBtn" hover-class="is-press" hover-stay-time="100" bindtap="confirmMultiAreaSetup">开牌，直接出结果</button>
            </view>
          </view>

          <view wx:if="{{!showVoiceInsight && areaStep == 'input'}}" class="intentPrompt">
            <text class="intentPromptTitle">随便写点什么</text>
            <text class="intentPromptCopy">一句话里混写心情、场景、预算、朋友位置</text>
          </view>

          <view wx:if="{{areaStep == 'input' || showVoiceInsight}}" class="momentComposerShell {{showVoiceInsight ? 'insightMode' : ''}}">
            <view wx:if="{{!showVoiceInsight && areaMode == 'multi'}}" class="multiSummaryRow">
              <text>{{multiAreaSummary}}</text>
              <button hover-class="is-press" hover-stay-time="80" bindtap="goMultiAreaSetup">改区域</button>
            </view>
            <view class="choiceComposer">
              <view class="composerInputPanel {{composerFocused ? 'is-focused' : ''}}">
                <view class="composerMiniHead">
                  <text class="composerAiBadge">AI生成入口</text>
                  <text class="composerMiniHint">不用先选标签</text>
                </view>
                <textarea
                  class="field bigInput composerInput"
                  value="{{problem}}"
                  bindinput="onProblemInput"
                  bindfocus="onComposerFocus"
                  bindblur="onComposerBlur"
                  maxlength="160"
                  placeholder="{{problemPlaceholder}}"
                />
                <view class="composerFootRow">
                  <text class="composerInputHint">随便说，心情预算都行</text>
                  <button class="composerMic round {{recording && voiceTarget == 'problem' ? 'rec' : ''}}" hover-class="is-press" hover-stay-time="80" catchtap="startChoiceVoice">
                    <view wx:if="{{recording && voiceTarget == 'problem'}}" class="micRipple">
                      <text></text>
                      <text></text>
                    </view>
                    <text class="micGlyph">🎙️</text>
                  </button>
                </view>
              </view>
            </view>

            <view wx:if="{{!showVoiceInsight}}" class="quickTags momentSignals">
              <view class="momentSignalsHead inspireToggle" bindtap="toggleInspiration">
                <text>没灵感？看看线索</text>
                <text>{{showInspiration ? '收起 ▲' : '展开 ▼'}}</text>
              </view>
              <block wx:if="{{showInspiration}}">
              <view class="quickTagRow">
                <text class="quickTagLabel">需求</text>
                <view class="quickTagRail">
                  <scroll-view class="quickTagScroller" scroll-x enhanced show-scrollbar="{{false}}">
                    <view class="quickTagTrack">
                      <button wx:for="{{needTags}}" wx:key="text" class="chip {{item.selected ? 'on' : ''}}" hover-class="is-press" hover-stay-time="60" data-group="needTags" data-index="{{index}}" bindtap="toggleTag">{{item.text}}</button>
                    </view>
                  </scroll-view>
                  <view class="quickTagFade"></view>
                </view>
              </view>
              <view class="quickTagRow">
                <text class="quickTagLabel">场景</text>
                <view class="quickTagRail">
                  <scroll-view class="quickTagScroller" scroll-x enhanced show-scrollbar="{{false}}">
                    <view class="quickTagTrack">
                      <button wx:for="{{sceneTags}}" wx:key="text" class="chip {{item.selected ? 'on' : ''}}" hover-class="is-press" hover-stay-time="60" data-group="sceneTags" data-index="{{index}}" bindtap="toggleTag">{{item.text}}</button>
                    </view>
                  </scroll-view>
                  <view class="quickTagFade"></view>
                </view>
              </view>
              <view class="quickTagRow">
                <text class="quickTagLabel">口味</text>
                <view class="quickTagRail">
                  <scroll-view class="quickTagScroller" scroll-x enhanced show-scrollbar="{{false}}">
                    <view class="quickTagTrack">
                      <button wx:for="{{moreTags}}" wx:key="text" class="chip {{item.selected ? 'on' : ''}}" hover-class="is-press" hover-stay-time="60" data-group="moreTags" data-index="{{index}}" bindtap="toggleTag">{{item.text}}</button>
                    </view>
                  </scroll-view>
                  <view class="quickTagFade"></view>
                </view>
              </view>

              <view class="preferenceSliders">
                <view class="preferenceSliderRow">
                  <view class="preferenceSliderHead">
                    <text class="quickTagLabel">人数</text>
                    <text class="preferenceValue">{{partySize}}人</text>
                  </view>
                  <slider
                    class="preferenceSlider"
                    min="1"
                    max="8"
                    step="1"
                    value="{{partySize}}"
                    activeColor="#f6c518"
                    backgroundColor="#d8d0be"
                    block-color="#1a1714"
                    block-size="24"
                    bindchanging="onPartySizeChange"
                    bindchange="onPartySizeChange"
                  />
                </view>
                <view class="preferenceSliderRow">
                  <view class="preferenceSliderHead">
                    <text class="quickTagLabel">预算</text>
                    <text class="preferenceValue">人均{{budgetPerPerson}}元</text>
                  </view>
                  <slider
                    class="preferenceSlider"
                    min="0"
                    max="500"
                    step="10"
                    value="{{budgetPerPerson}}"
                    activeColor="#f6c518"
                    backgroundColor="#d8d0be"
                    block-color="#1a1714"
                    block-size="24"
                    bindchanging="onBudgetChange"
                    bindchange="onBudgetChange"
                  />
                </view>
              </view>
              </block>
            </view>

            <view wx:if="{{!showVoiceInsight && photoThumbs.length}}" class="thumbRow">
              <image wx:for="{{photoThumbs}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" lazy-load="{{true}}"></image>
            </view>

            <view wx:if="{{!showVoiceInsight}}" class="choiceActionRow">
              <button class="choiceNextBtn {{choiceHasInput ? '' : 'disabled'}}" hover-class="{{choiceHasInput ? 'is-press' : ''}}" hover-stay-time="100" bindtap="proceedChoiceToMode">{{choiceNextText}}</button>
            </view>

            <!-- 咖啡/奶茶/外卖三个快捷分支已暂时下线(底层引擎与品牌数据保留,后续可恢复) -->

            <view wx:if="{{!showVoiceInsight && areaMode != 'multi'}}" class="homeOrDivider">— 或者 —</view>
            <view wx:if="{{!showVoiceInsight && areaMode != 'multi'}}" class="groupEntryCard" data-mode="multi" hover-class="is-press" hover-stay-time="80" bindtap="selectAreaMode">
              <view class="groupEntryMain">
                <text class="groupEntryTitle">👥 多人组局</text>
                <text class="groupEntryDesc">好友分散在城市各处？各报位置，自动找中间点，一起开局</text>
                <view class="groupEntryAvatars">
                  <text class="geAv av1">鹿</text>
                  <text class="geAv av2">凯</text>
                  <text class="geAv av3">三</text>
                  <text class="geAv geAdd">+</text>
                </view>
              </view>
              <text class="groupEntryArrow">→</text>
            </view>
          </view>

          <view wx:if="{{showVoiceInsight}}" class="voiceInsight {{voiceInsightState}}">
            <view class="aiGeneratedNotice">
              <text>AI生成内容提示</text>
              <text>餐厅筛选和条件整理由 AI/规则辅助生成，仅供参考</text>
            </view>
            <view class="voiceInsightHeader">
              <text>{{voiceInsightQuestion}}</text>
            </view>
            <view wx:if="{{voiceInsightState != 'loading'}}" class="voiceInsightSummary">
              <view wx:for="{{voiceIntentDetails}}" wx:key="key" wx:if="{{item.summary}}" class="voiceSummaryChip">
                <text>{{item.label}}</text>
                <text>{{item.value}}</text>
              </view>
            </view>
            <view class="voiceSectionTitle">{{voiceInsightState == 'loading' ? '理解进度' : '理解明细，点卡片可修改'}}</view>
            <view class="voiceInsightDetails">
              <view
                wx:for="{{voiceIntentDetails}}"
                wx:key="key"
                class="voiceInsightItem {{item.wide ? 'wide' : ''}} {{editingVoiceIntentIndex == index ? 'editing' : ''}} {{item.editable ? 'editable' : ''}}"
                data-index="{{index}}"
                bindtap="onVoiceIntentItemTap"
              >
                <view class="voiceInsightItemTop">
                  <text class="voiceInsightKey">{{item.label}}</text>
                  <text wx:if="{{item.editable}}" class="voiceInsightEditHint">{{editingVoiceIntentIndex == index ? '编辑中' : '点改'}}</text>
                </view>
                <block wx:if="{{item.editable && editingVoiceIntentIndex == index}}">
                  <textarea
                    wx:if="{{item.multiline}}"
                    class="voiceInsightInput multiline"
                    value="{{item.value}}"
                    auto-height="{{false}}"
                    show-confirm-bar="{{false}}"
                    maxlength="140"
                    focus="{{editingVoiceIntentIndex == index}}"
                    data-index="{{index}}"
                    bindinput="onVoiceIntentFieldInput"
                  />
                  <input
                    wx:else
                    class="voiceInsightInput"
                    value="{{item.value}}"
                    maxlength="80"
                    focus="{{editingVoiceIntentIndex == index}}"
                    data-index="{{index}}"
                    bindinput="onVoiceIntentFieldInput"
                  />
                </block>
                <text wx:else class="voiceInsightVal">{{item.value}}</text>
              </view>
            </view>
            <view wx:if="{{voiceInsightState == 'loading'}}" class="voiceInsightLoading">
              <text class="voiceLoadingDot"></text>
              <text>理解完成后再确认</text>
            </view>
            <view wx:else class="voiceInsightActions">
              <button class="intentBtn primary" hover-class="is-press" hover-stay-time="80" bindtap="confirmChoiceIntent">按改好的条件重新发牌</button>
              <button class="intentBtn ghost" hover-class="is-press" hover-stay-time="80" bindtap="reviseChoiceIntent">回去改原话</button>
            </view>
          </view>

        </view>
      </view>
    </view>

    <view wx:if="{{screen == 'deck'}}" class="screen deckScreen active">
      <view class="topbar">
        <text class="badge purple">{{loadingDeck ? '牌局开始' : '第 ' + (activeCard ? activeCard.no : 1) + ' / ' + totalCards + ' 张'}}</text>
        <text class="aiDeckNotice">AI生成推荐，仅供参考</text>
        <button class="intentEditLink" bindtap="openIntentEditor">条件不对？改一下</button>
        <button class="back" bindtap="goBackGame">← 返回</button>
      </view>

      <view class="counter">
        <text>这局只有</text>
        <view class="pips">
          <text wx:for="{{pips}}" wx:key="index" class="pip {{item.spent ? 'spent' : ''}}"></text>
        </view>
        <text class="leftN">{{leftN}}</text>
        <text>张 · 看清楚再滑</text>
      </view>

      <view wx:if="{{roundSlogan}}" class="roundSlogan">{{roundSlogan}}</view>

      <view class="deckWrap">
        <view class="deck">
          <view wx:if="{{loadingDeck}}" class="gcard loadingCard">
            <text class="spinner"></text>
            <text class="loadingTitle">{{loadingTitle}}</text>
            <text class="loadingText">{{loadingText}}</text>
            <view wx:if="{{loadingProgressVisible}}" class="loadingProgress">
              <view class="loadingBar" style="width: {{loadingPercent}}%;"></view>
            </view>
            <text wx:if="{{loadingProgressVisible}}" class="loadingCount">已备好 {{loadingDone}} / {{loadingTotal}} 张</text>
            <button wx:if="{{loadingError}}" class="loadingRetry" bindtap="retryDeckSearch">{{loadingActionText}}</button>
          </view>

          <block wx:elif="{{activeCard}}">
            <view wx:for="{{deckLayers}}" wx:key="level" class="gcard backCard layer{{item.level}}"></view>
            <view
              class="gcard faceCard {{cardMotionClass}} {{activeCard.arrivalBoard ? 'hasBoard' : ''}}"
              style="transform: {{cardTransform}};"
              bindtouchstart="onCardTouchStart"
              bindtouchmove="onCardTouchMove"
              bindtouchend="onCardTouchEnd"
              bindtouchcancel="onCardTouchEnd"
              bindtap="openActiveCardDetail"
            >
              <view wx:if="{{activeCard.photoSlides && activeCard.photoSlides.length}}" class="art photoCarouselWrap">
                <swiper class="photoCarousel" circular="{{false}}" current="0" duration="220" indicator-dots="{{false}}">
                  <swiper-item wx:for="{{activeCard.photoSlides}}" wx:key="url" class="photoSlide">
                    <image class="artPhoto" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" binderror="onCardImageError"></image>
                    <view class="photoShade"></view>
                    <text class="photoChip">{{item.label}}</text>
                  </swiper-item>
                </swiper>
                <view class="photoDetailHint">点击查看详情</view>
                <view wx:if="{{activeCard.photoSlides.length > 1}}" class="photoDots">
                  <text wx:for="{{activeCard.photoSlides}}" wx:key="url" class="photoDot {{index == 0 ? 'on' : ''}}"></text>
                </view>
              </view>
              <view wx:else class="art foodArt" style="background: {{activeCard.artBg}};">
                <view class="artOrb top" style="background: {{activeCard.artAccent}};"></view>
                <view class="artOrb bottom"></view>
                <view class="artLine top"></view>
                <view class="artLine bottom"></view>
                <view class="artMark m1"></view>
                <view class="artMark m2"></view>
                <view class="artMark m3"></view>
                <view class="artMark m4"></view>
                <view class="artCenter"><text>{{activeCard.emoji}}</text></view>
              </view>
              <view class="info" style="background: {{activeCard.infoBg}}; color: {{activeCard.infoFg}};">
                <text class="cnum" style="color: {{activeCard.infoMuted}};">第 {{activeCard.no}} / {{totalCards}} 家 · 按当前定位找</text>
                <text class="cardName">{{activeCard.name}}</text>
                <view wx:if="{{activeCard.preferred}}" class="preferredTag">⭐ 你常点</view>
                <view wx:if="{{activeCard.newDrop}}" class="newDropTag"><text class="newDropDot">新</text>最近上新 · {{activeCard.newDrop}}</view>
                <view wx:if="{{activeCard.summaryPills && activeCard.summaryPills.length}}" class="summaryGrid">
                  <text wx:for="{{activeCard.summaryPills}}" wx:key="text" class="summaryPill {{item.wide ? 'wide' : 'compact'}}">{{item.text}}</text>
                </view>
                <view wx:elif="{{activeCard.meta && activeCard.meta.length}}" class="metaRow">
                  <text wx:for="{{activeCard.meta}}" wx:key="*this" class="mtag" style="background: {{activeCard.tagBg}}; color: {{activeCard.tagFg}};">{{item}}</text>
                </view>
                <view wx:if="{{activeCard.arrivalBoard}}" class="arrivalBoard" data-card-action="meetup">
                  <view class="arrivalBoardHead">
                    <text>谁到这儿要多久</text>
                    <text class="arrivalBoardHint">点一行换交通方式</text>
                  </view>
                  <view wx:for="{{activeCard.arrivalBoard.rows}}" wx:key="label" class="arrivalRow {{item.expanded ? 'open' : ''}}" data-index="{{index}}" data-card-action="meetup" hover-stop-propagation="{{true}}" catchtap="toggleArrivalRow">
                    <view class="arrivalRowTop">
                      <text class="arrivalAvatar">{{item.short}}</text>
                      <text class="arrivalPlace">{{item.label}}</text>
                      <text wx:if="{{item.farthest}}" class="arrivalFarTag">最远</text>
                      <text class="arrivalMin {{item.farthest ? 'far' : ''}}">{{item.recommendedText}}</text>
                      <text class="arrivalCaret">{{item.expanded ? '▲' : '▼'}}</text>
                    </view>
                    <view wx:if="{{item.expanded}}" class="arrivalModes">
                      <view wx:for="{{item.modes}}" wx:for-item="mode" wx:key="key" class="arrivalMode {{mode.on ? 'on' : ''}} {{mode.tooFar ? 'dim' : ''}}">
                        <view class="arrivalModeLine">
                          <text class="arrivalModeName">{{mode.icon}} {{mode.name}} {{mode.minText}}</text>
                          <text wx:if="{{mode.note}}" class="arrivalModeNote">{{mode.note}}</text>
                        </view>
                        <view wx:if="{{mode.key == 'subway' && mode.rideMin}}" class="arrivalSeg">
                          <view class="arrivalSegBar">
                            <view class="segWalk" style="flex: {{mode.walkMin}};"></view>
                            <view class="segRide" style="flex: {{mode.rideMin}};"></view>
                            <view class="segWalk" style="flex: {{mode.walkMin}};"></view>
                          </view>
                          <view class="arrivalSegText">
                            <text>步行 {{mode.walkMin}} 分</text>
                            <text>乘车 {{mode.rideMin}} 分</text>
                            <text>步行 {{mode.walkMin}} 分</text>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>
                  <text wx:if="{{activeCard.arrivalBoard.summary}}" class="arrivalSummary">{{activeCard.arrivalBoard.summary}}</text>
                </view>
                <view wx:elif="{{activeCard.meetupPanel}}" class="meetupPanel" data-card-action="meetup">
                  <view wx:if="{{activeCard.meetupPanel.summaryPills && activeCard.meetupPanel.summaryPills.length}}" class="meetupSummary">
                    <text wx:for="{{activeCard.meetupPanel.summaryPills}}" wx:key="text" class="meetupSummaryPill">{{item.text}}</text>
                  </view>
                  <view wx:if="{{activeCard.meetupPanel.routes && activeCard.meetupPanel.routes.length}}" class="meetupTabs">
                    <button wx:for="{{activeCard.meetupPanel.routes}}" wx:key="label" class="meetupTab {{item.long ? 'long' : ''}} {{index == activeCard.meetupPanel.selectedIndex ? 'on' : ''}}" data-index="{{index}}" data-card-action="meetup" hover-stop-propagation="{{true}}" catchtap="selectActiveMeetupRoute">{{item.label}}</button>
                  </view>
                  <text wx:if="{{activeCard.meetupPanel.activeRoute}}" class="meetupRouteText">{{activeCard.meetupPanel.activeRoute.text}}</text>
                </view>
                <view class="cardFootRow">
                  <text class="cardDetailHint">AI生成推荐 · 点卡片看详情</text>
                  <view class="cardFootBtns">
                    <button wx:if="{{activeCard.category}}" class="cardNavBtn order" data-card-action="navigation" hover-stop-propagation="{{true}}" catchtap="orderActiveCard">
                      <text class="cardNavIcon" data-card-action="navigation">🛒</text>
                      <text data-card-action="navigation">去下单</text>
                    </button>
                    <button wx:if="{{activeCard.location || activeCard.navLocation || activeCard.poi.location || activeCard.poi.navLocation}}" class="cardNavBtn" data-card-action="navigation" hover-stop-propagation="{{true}}" catchtap="openActiveCardNavigation">
                      <text class="cardNavIcon" data-card-action="navigation">📍</text>
                      <text data-card-action="navigation">去导航</text>
                    </button>
                  </view>
                </view>
              </view>
              <text class="stamp s-r" style="opacity: {{stampPick}};">就它</text>
              <text class="stamp s-l" style="opacity: {{stampPass}};">换</text>
            </view>
          </block>
        </view>
      </view>

      <view wx:if="{{activeCard && !loadingDeck}}" class="deckControls">
        <button class="ctrlSide ctrlPass" hover-class="is-press" hover-stay-time="80" data-dir="left" bindtap="tapDecision">
          <text class="big">✕ 换一家</text>
          <text class="sm">左滑换</text>
        </button>
        <button class="ctrlSide ctrlPick" hover-class="is-press" hover-stay-time="80" data-dir="right" bindtap="tapDecision">
          <text class="big">✓ 就这家</text>
          <text class="sm">右滑要</text>
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{toastText}}" class="toast show">{{toastText}}</view>

  <view wx:if="{{showWin}}" class="confetti">
    <text wx:for="{{confettiPieces}}" wx:key="index" class="conf conf{{index}}" style="left: {{item.left}}%; background: {{item.color}}; animation-delay: {{item.delay}}ms; animation-duration: {{item.duration}}ms;"></text>
  </view>

  <view wx:if="{{showWin}}" class="win show">
    <view class="winCard">
      <text class="tag">拍板</text>
      <text class="cg">就这家，别纠结了！</text>
      <text class="settleBig">{{settleText}}</text>
      <view wx:if="{{winner.image}}" class="face photo">
        <image class="artPhoto" src="{{winner.image}}" mode="aspectFill" binderror="onWinnerImageError"></image>
        <view class="photoShade"></view>
      </view>
      <view wx:else class="face foodArt" style="background: {{winner.artBg}};">
        <view class="artOrb top" style="background: {{winner.artAccent}};"></view>
        <view class="artOrb bottom"></view>
        <view class="artLine top"></view>
        <view class="artLine bottom"></view>
        <view class="artMark m1"></view>
        <view class="artMark m2"></view>
        <view class="artMark m3"></view>
        <view class="artMark m4"></view>
        <view class="artCenter"><text>{{winner.emoji}}</text></view>
      </view>
      <text class="winName">{{winner.name}}</text>
      <text class="winReason">{{winner.winReason}}</text>
      <view class="metaRow winMeta">
        <text wx:for="{{winner.meta}}" wx:key="*this" class="mtag">{{item}}</text>
      </view>
      <view wx:if="{{departureAdvice && departureAdvice.length}}" class="departAdvice">
        <text class="departTitle">出发建议</text>
        <text wx:for="{{departureAdvice}}" wx:key="*this" class="departLine">{{item}}</text>
      </view>
      <view class="links">
        <button wx:if="{{winner.category}}" class="btn alt" hover-class="is-press" hover-stay-time="80" bindtap="orderWinner">🛒 去下单</button>
        <button class="btn alt" hover-class="is-press" hover-stay-time="80" bindtap="openWinnerNavigation">去导航</button>
        <button class="btn ghost" hover-class="is-press" hover-stay-time="80" bindtap="openWinnerDetail">看详情</button>
      </view>
      <button class="btn" hover-class="is-press" hover-stay-time="80" bindtap="resetAll">不满意？再来一局</button>
    </view>
  </view>

  <view wx:if="{{showPoiDetail}}" class="poiDetail">
      <view class="poiDetailCard">
        <view class="poiDetailHero" bindtap="previewDetailHeroPhoto">
        <image wx:if="{{detailCard.image}}" class="poiDetailHeroImage" src="{{detailCard.image}}" mode="aspectFill" data-url="{{detailCard.image}}" binderror="onDetailImageError"></image>
        <view class="poiDetailHeroShade"></view>
        <view class="poiDetailTop">
          <text class="poiDetailBadge">餐厅详情</text>
          <button class="detailClose" hover-class="is-press" hover-stay-time="80" catchtap="closePoiDetail">×</button>
        </view>
        <text class="detailName">{{detailCard.name}}</text>
      </view>
      <scroll-view class="detailBody" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="detailAiNotice">
          <text>AI生成内容提示</text>
          <text>菜品、到店时间和筛选理由由 AI/规则辅助整理，请以商家和地图信息为准</text>
        </view>
        <view class="detailFactGrid">
          <view wx:for="{{detailCard.detailFacts}}" wx:key="label" class="detailFact">
            <text>{{item.value}}</text>
            <text>{{item.label}}</text>
          </view>
        </view>
        <view class="detailDecision">
          <view class="detailDecisionTitle">
            <text>先判断值不值得去</text>
            <text>营业 {{detailCard.openTimeText || '以高德为准'}}</text>
          </view>
          <view class="detailFeatureBlock">
            <text class="detailFeatureTitle">菜品 / 类型线索</text>
            <view class="detailFeatureChips">
              <text wx:for="{{detailCard.detailFeatures}}" wx:key="*this" class="detailFeatureChip">{{item}}</text>
            </view>
            <text wx:if="{{!detailCard.detailFeatures || !detailCard.detailFeatures.length}}" class="detailFeatureEmpty">暂无明确菜品或类型线索</text>
          </view>
          <view class="detailQualityGrid">
            <view class="detailQualityItem"><text>评分</text><text>{{detailCard.ratingText || '暂无'}}</text></view>
            <view class="detailQualityItem"><text>人均</text><text>{{detailCard.costText || '暂无'}}</text></view>
          </view>
          <view class="detailCommuteBlock">
            <text class="detailFeatureTitle">到店时间</text>
            <view class="detailRouteList">
              <scroll-view wx:if="{{detailCard.detailRoutes && detailCard.detailRoutes.length > 1}}" class="detailRouteTabs" scroll-x enhanced show-scrollbar="{{false}}">
                <view class="detailRouteTabTrack">
                  <button wx:for="{{detailCard.detailRoutes}}" wx:key="label" class="detailRouteTab {{item.long ? 'long' : ''}} {{index == detailCard.detailRouteIndex ? 'on' : ''}}" data-index="{{index}}" catchtap="selectDetailRoute">{{item.label}}</button>
                </view>
              </scroll-view>
              <view wx:if="{{detailCard.activeDetailRoute}}" class="detailRouteRow">
                <text class="detailRouteName {{detailCard.activeDetailRoute.long ? 'long' : ''}}">{{detailCard.activeDetailRoute.label}}</text>
                <view class="detailRouteStats">
                  <text wx:for="{{detailCard.activeDetailRoute.stats}}" wx:key="*this" class="detailRouteStat">{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <scroll-view wx:if="{{detailCard.detailPhotos && detailCard.detailPhotos.length}}" class="detailPhotoStrip" scroll-x enhanced show-scrollbar="{{false}}">
          <view wx:for="{{detailCard.detailPhotos}}" wx:key="url" class="detailPhoto {{index == detailPhotoIndex ? 'active' : ''}}" data-url="{{item.url}}" data-index="{{index}}" bindtap="previewDetailPhoto">
            <image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" binderror="onDetailImageError" lazy-load="{{true}}"></image>
            <text>{{item.label}}</text>
          </view>
        </scroll-view>
        <view class="detailSectionTitle">实用信息</view>
        <view class="detailGrid">
          <view wx:for="{{detailCard.detailRows}}" wx:key="label" class="detailItem {{item.wide ? 'wide' : ''}} {{item.secondary ? 'secondary' : ''}}">
            <text>{{item.label}}</text>
            <text>{{item.value}}</text>
          </view>
        </view>
        <view class="detailActions">
          <button wx:if="{{detailCard.location || detailCard.navLocation || detailCard.poi.location || detailCard.poi.navLocation}}" class="btn alt" hover-class="is-press" hover-stay-time="80" bindtap="openDetailNavigation">📍 去导航</button>
          <button wx:if="{{detailCard.location || detailCard.navLocation || detailCard.poi.location || detailCard.poi.navLocation}}" class="btn ghost" hover-class="is-press" hover-stay-time="80" bindtap="openDetailAmapLink">打开地图</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
